{
  "Debug Log": {
    "prefix": "ld",
    "body": [
      "${1:variable}.log.Debug(\"${2:message}\")"
    ],
    "description": "Insert a debug log line"
  },
  "Table Test with cmp.Diff": {
    "prefix": "tt",
    "body": [
      "func Test${1:Function}(t *testing.T) {",
      "  tests := []struct {",
      "    name string",
      "    input ${2:Type}",
      "    want ${3:Type}",
      "  }{",
      "    // TODO: Add test cases.",
      "  }",
      "  for _, tt := range tests {",
      "    t.Run(tt.name, func(t *testing.T) {",
      "      got := ${4:Function}(tt.input)",
      "      if diff := cmp.Diff(tt.want, got); diff != \"\" {",
      "        t.Errorf(\"%s() mismatch (-want +got):\\n%s\", tt.name, diff)",
      "      }",
      "    })",
      "  }",
      "}"
    ],
    "description": "Insert a table-driven test with cmp.Diff"
  }
}
